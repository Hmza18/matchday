# Copy to .env — only EXPO_PUBLIC_* vars are inlined into the mobile bundle.

# Supabase (leave blank to run in guest/mock mode)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Football API
EXPO_PUBLIC_API_BASE_URL=https://worldcup26.ir
EXPO_PUBLIC_API_KEY=

# Serve bundled fixtures instead of network calls
EXPO_PUBLIC_MOCK_MODE=false

# Legal pages (hosted URLs for App Store Connect)
EXPO_PUBLIC_PRIVACY_URL=https://matchday.app/privacy
EXPO_PUBLIC_TERMS_URL=https://matchday.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@matchday.app
